{
  "name": "crown-drive-academy",
  "productName": "CROWN DRIVE ACADEMY",
  "version": "1.0.0",
  "description": "CROWN DRIVE ACADEMY - تطبيق سطح المكتب",
  "author": "CROWN DRIVE ACADEMY",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite --port 5173 --strictPort\" \"wait-on http-get://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.crowndrive.academy",
    "productName": "CROWN DRIVE ACADEMY",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "CROWN-DRIVE-ACADEMY-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "arRazik",
      "repo": "crown-drive-academy",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axios": "^1.19.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "notistack": "^3.0.2",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arRazik/crown-drive-academy.git"
  }
}
